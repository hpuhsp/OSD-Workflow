{
  "schema": "osd-archive-result/v1",
  "feature": "{feature}",
  "status": "archived|active|blocked",
  "native_command": "openspec archive {feature} --yes [--skip-specs]",
  "exit_code": 0,
  "archived_change_location": "openspec/changes/archive/YYYY-MM-DD-{feature}",
  "knowledge_sync": "not_required|passed|failed",
  "completed_at": "ISO-8601 timestamp",
  "summary": "short observed result",
  "provenance": {
    "schema": "osd-native-archive-attestation/v1",
    "runner": "osd-openspec-archive",
    "argv": ["openspec", "archive", "{feature}", "--yes"],
    "repository_revision": "Git revision or unavailable",
    "workspace_dirty": false,
    "started_at": "ISO-8601 timestamp",
    "recorded_at": "ISO-8601 timestamp"
  }
}
