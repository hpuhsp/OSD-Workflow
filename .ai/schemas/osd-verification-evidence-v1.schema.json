{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osd-verification-evidence/v1",
  "type": "object",
  "required": ["schema", "feature", "strategy", "steps"],
  "properties": {
    "schema": {"const": "osd-verification-evidence/v1"}, "feature": {"type": "string", "minLength": 1}, "strategy": {"enum": ["tdd", "test_first", "verification_only"]},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["step", "command_id", "exit_code", "observed_at", "covered_acceptance_criteria"], "properties": {"step": {"enum": ["red", "green", "refactor", "failing_before", "passing_after", "focused"]}, "command_id": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"}, "observed_at": {"type": "string", "minLength": 1}, "covered_acceptance_criteria": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]+$"}}, "summary": {"type": "string"}, "provenance": {"type": "object"}}}}
  }
}
