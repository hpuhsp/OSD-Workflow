{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osd-runtime-context/v1",
  "type": "object",
  "required": ["schema", "contract_version", "feature", "mode", "strategy", "task_id", "acceptance_criteria", "assignments", "status", "reasons", "generated_at"],
  "properties": {
    "schema": {"const": "osd-runtime-context/v1"},
    "contract_version": {"type": "string", "minLength": 1},
    "feature": {"type": "string", "minLength": 1},
    "mode": {"enum": ["lite", "standard", "strict"]},
    "strategy": {"enum": ["tdd", "test_first", "verification_only"]},
    "task_id": {"type": "string", "pattern": "^T-[0-9]+$"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AC-[0-9]+$"}},
    "assignments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "status": {"enum": ["runnable", "blocked"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string", "minLength": 1}
  }
}
