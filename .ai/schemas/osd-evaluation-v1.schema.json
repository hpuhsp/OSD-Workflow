{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osd-evaluation/v1",
  "type": "object",
  "required": ["schema", "feature", "context_package_version", "policy_version", "deterministic_checks", "optional_graders"],
  "properties": {
    "schema": {"const": "osd-evaluation/v1"}, "feature": {"type": "string", "minLength": 1}, "context_package_version": {"type": "string", "minLength": 1}, "policy_version": {"type": "string", "minLength": 1},
    "deterministic_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command_id", "exit_code", "covered_acceptance_criteria"], "properties": {"command_id": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"}, "covered_acceptance_criteria": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]+$"}}}}},
    "optional_graders": {"type": "array", "items": {"type": "object", "required": ["evaluator", "rubric_version", "status"], "properties": {"evaluator": {"type": "string", "minLength": 1}, "rubric_version": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "not_run"]}}}}
  }
}
