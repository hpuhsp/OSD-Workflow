{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "osd-run-event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "feature", "stage", "actor_role", "event_type", "status", "timestamp", "contract_version"],
  "properties": {
    "schema": {"const": "osd-run-event/v1"}, "run_id": {"type": "string", "minLength": 1}, "feature": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "stage": {"type": "string", "minLength": 1},
    "actor_role": {"enum": ["coordinator", "executor", "test_verifier", "reviewer", "monitor"]}, "event_type": {"enum": ["role_started", "role_completed", "policy_allowed", "policy_denied", "verification_completed", "evaluation_completed", "monitor_alert"]}, "status": {"enum": ["started", "completed", "blocked", "denied", "failed"]},
    "timestamp": {"type": "string", "minLength": 1}, "contract_version": {"type": "string", "minLength": 1}, "duration_ms": {"type": "integer"}, "command_id": {"type": "string", "minLength": 1}, "tool_id": {"type": "string", "minLength": 1}, "retry_count": {"type": "integer"}, "external_trace_id": {"type": "string", "minLength": 1}, "token_total": {"type": "integer"}, "cost_total": {"type": "number"}
  }
}
