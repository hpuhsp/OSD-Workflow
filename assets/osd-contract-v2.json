{
  "schema": "osd-contract/v2",
  "controller": "osd_workflow",
  "stages": ["specification", "approval", "planning", "implementation", "verification", "review", "archive", "complete"],
  "task_types": ["new_feature", "bug_fix", "existing_change", "refactor", "maintenance"],
  "development_strategies": ["tdd", "test_first", "verification_only"],
  "guarantees": [
    "specification precedes implementation",
    "verification evidence precedes archive",
    "strict delivery requires passing review",
    "native adapters are selected before fallbacks",
    "fallback usage is stored in delivery state"
  ]
}
